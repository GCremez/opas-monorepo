    "ajv": "^8.20.0",
    "axios": "^1.7.0",
    "expo": "^58.0.14",
    "expo-calendar": "~58.0.6",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
