    "@tanstack/react-query": "^5.0.0",
    "ajv": "^8.20.0",
    "axios": "^1.7.0",
    "expo": "^57.0.30",
    "expo-calendar": "^57.0.5",
    "expo-camera": "^57.0.6",
    "expo-clipboard": "^57.0.2",
    "expo-constants": "^57.0.22",
    "expo-device": "^57.0.2",
    "expo-font": "^57.0.4",
    "expo-image-picker": "^57.0.20",
