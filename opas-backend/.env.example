# Copy to .env.local — never commit real values

DATABASE_URL=jdbc:postgresql://localhost:5432/opas
DATABASE_USER=opas
DATABASE_PASSWORD=opas

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://opas:opas@localhost:5672

# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Get from https://platform.openai.com
OPENAI_API_KEY=sk-...

# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# LocalStack (local dev) — omit endpoint & keys for real AWS (uses DefaultCredentialsProvider)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_NAME=opas-uploads-dev

PRESIDIO_SIDECAR_URL=http://localhost:5001
