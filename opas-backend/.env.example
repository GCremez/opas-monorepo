# Copy to .env.local — never commit real values

DATABASE_URL=jdbc:postgresql://opas-database.ct88sic8yy3s.eu-north-1.rds.amazonaws.com:5432/postgres
DATABASE_USER=opas_db
DATABASE_PASSWORD=opas

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://opas:opas@localhost:5672

# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Get from https://platform.openai.com
OPENAI_API_KEY=sk-...

# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AWS — omit keys for deployed env (uses IAM role / DefaultCredentialsProvider)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
S3_BUCKET_NAME=opas-app-bucket

PRESIDIO_SIDECAR_URL=http://localhost:5001
