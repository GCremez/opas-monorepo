# Copy to .env.local — never commit real values

DATABASE_URL=jdbc:postgresql://localhost:5432/opas
DATABASE_USER=opas
DATABASE_PASSWORD=opas

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://opas:opas@localhost:5672

# Generate JWT keys (PKCS#8 format):
#   openssl genrsa -out private.pem 2048
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -out private-pkcs8.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the full PEM (including headers) as a single line
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# false = checkout/portal return mock URLs (local dev without Stripe)
STRIPE_ENABLED=false
# Comma-separated price IDs that grant premium. Used for the checkout allowlist and to
# map webhook subscriptions to a tier; without it webhook updates leave the tier alone.
STRIPE_PREMIUM_PRICE_IDS=price_...

# AWS — omit keys for deployed env (uses IAM role / DefaultCredentialsProvider)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
S3_BUCKET_NAME=opas-app-bucket

# OCR (image scans). LocalStack's free tier has no Textract, so local dev calls real
# AWS: use an IAM user limited to textract:DetectDocumentText. Region must offer
# Textract (eu-north-1 doesn't).
TEXTRACT_REGION=eu-central-1
TEXTRACT_ACCESS_KEY=
TEXTRACT_SECRET_KEY=

PRESIDIO_SIDECAR_URL=http://localhost:5001

# Comma-separated allowed CORS origins (leave empty for development)
CORS_ALLOWED_ORIGINS=http://localhost:3000
