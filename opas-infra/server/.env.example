# Copy to .env on the server and fill in. Never commit .env.

# Domain that points at this server (DNS A record). Caddy gets the certificate itself.
API_DOMAIN=api.getopas.app

# Passwords for the services on this server. Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# JWT keys, one line each with \n for line breaks (see README.md, step 5).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# AWS: an IAM user's access key with the policy in README.md (S3, Textract, SES, Bedrock).
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
TEXTRACT_REGION=eu-central-1

# Claude: bedrock (default, eu-north-1) or anthropic (needs ANTHROPIC_API_KEY).
AI_PROVIDER=bedrock
BEDROCK_REGION=eu-north-1
ANTHROPIC_API_KEY=

# Email (Amazon SES). Keep false until the getopas.app domain is verified in SES.
MAIL_ENABLED=false
MAIL_FROM=no-reply@getopas.app

# Payments stay off for the beta (the apps show no checkout).
STRIPE_ENABLED=false
