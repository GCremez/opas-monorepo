[
  {
    "name": "backend",
    "image": "ghcr.io/GCremez/opas-backend:IMAGE_TAG_PLACEHOLDER",
    "essential": true,
    "portMappings": [
      {
        "containerPort": 8080,
        "protocol": "tcp"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/opas-backend-production",
        "awslogs-region": "eu-north-1",
        "awslogs-stream-prefix": "backend"
      }
    },
    "environment": [
      { "name": "SPRING_PROFILES_ACTIVE", "value": "production" },
      { "name": "AWS_REGION", "value": "eu-north-1" },
      { "name": "S3_BUCKET_NAME", "value": "opas-app-bucket-production" },
      { "name": "CORS_ALLOWED_ORIGINS", "value": "https://app.opas.fi" },
      { "name": "JWT_PUBLIC_KEY", "value": "{{resolve:secretsmanager:opas/production/jwt-public-key}}" },
      { "name": "DATABASE_USER", "value": "{{resolve:secretsmanager:opas/production/database-user}}" },
      { "name": "PRESIDIO_SIDECAR_URL", "value": "{{resolve:secretsmanager:opas/production/presidio-url}}" }
    ],
    "secrets": [
      { "name": "JWT_PRIVATE_KEY", "valueFrom": "arn:aws:secretsmanager:eu-north-1:ACCOUNT_ID_PLACEHOLDER:secret:opas/production/jwt-private-key" },
      { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:eu-north-1:ACCOUNT_ID_PLACEHOLDER:secret:opas/production/database-url" },
      { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:eu-north-1:ACCOUNT_ID_PLACEHOLDER:secret:opas/production/redis-url" },
      { "name": "RABBITMQ_URL", "valueFrom": "arn:aws:secretsmanager:eu-north-1:ACCOUNT_ID_PLACEHOLDER:secret:opas/production/rabbitmq-url" },
      { "name": "DATABASE_PASSWORD", "valueFrom": "arn:aws:secretsmanager:eu-north-1:ACCOUNT_ID_PLACEHOLDER:secret:opas/production/database-password" },
      { "name": "ANTHROPIC_API_KEY", "valueFrom": "arn:aws:secretsmanager:eu-north-1:ACCOUNT_ID_PLACEHOLDER:secret:opas/production/anthropic-api-key" },
      { "name": "STRIPE_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:eu-north-1:ACCOUNT_ID_PLACEHOLDER:secret:opas/production/stripe-secret-key" },
      { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-north-1:ACCOUNT_ID_PLACEHOLDER:secret:opas/production/stripe-webhook-secret" }
    ],
    "healthCheck": {
      "command": ["CMD-SHELL", "curl -sf http://localhost:8080/actuator/health || exit 1"],
      "interval": 30,
      "retries": 3,
      "timeout": 5,
      "startPeriod": 60
    }
  }
]
